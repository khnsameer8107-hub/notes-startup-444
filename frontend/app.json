{
  "expo": {
    "name": "Notes",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.vaultmobile.wbkcgw",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to attach to your notes",
        "NSMicrophoneUsageDescription": "Record voice notes on your device",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to notes",
        "NSFaceIDUsageDescription": "Unlock your private notes with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#181715"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.vaultmobile.wbkcgw",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to notes",
          "cameraPermission": "Take photos to attach to your notes"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private notes with Face ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#181715"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}